{
  "name": "stillweb",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "npm run build:rust:android && expo run:android",
    "ios": "expo run:ios",
    "build:rust:android": "bash scripts/build-rust-android.sh",
    "build:filters": "node scripts/filters/build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./native"
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@mozilla/readability": "^0.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-background-task": "~57.0.21",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@duckduckgo/autoconsent": "^16.45.0",
